# Build from the editable source root. Installed dependencies are rebuilt from
# pinned lockfiles; host state and signing material never belong in the context.
.git
**/.git
.artifacts
**/.artifacts
node_modules
**/node_modules
.venv
**/.venv
venv
**/venv
__pycache__
**/__pycache__
**/*.pyc
.cache
**/.cache
.pytest_cache
**/.pytest_cache
.mypy_cache
**/.mypy_cache
**/*.sqlite
**/*.sqlite3
**/*.db
.DS_Store
**/.DS_Store
web-chain/dist
web-chain/dist-public-testnet

